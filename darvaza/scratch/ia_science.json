26"},{"name":"Sciencei1956_3.thumbs\/50509A_000720.jpg","source":"derivative","format":"Thumbnail","original":"50509A.MPG","md5":"3d7d5397773db3d7c45c85247b717695","mtime":"1227966765","size":"6992","crc32":"e7b1ff0c","sha1":"1d010c2a5b51cc259da1df69f80c5539880e7e64"},{"name":"Sciencei1956_3_archive.torrent","source":"metadata","btih":"7792483e6cea7b730ec700f15dc6e75188b648db","mtime":"1691352156","size":"23801","md5":"2c26399028ea622ee2021c94012cca37","crc32":"718b2ede","sha1":"ab032070e9dd1b65fe2be02368ceff8349935eb4","format":"Archive BitTorrent"},{"name":"Sciencei1956_3_files.xml","source":"metadata","format":"Metadata","md5":"e339f7ad1fd71480e866acf64b8d39ab","summation":"md5"},{"name":"Sciencei1956_3_meta.xml","source":"metadata","format":"Metadata","mtime":"1691352146","size":"1277","md5":"c47d74a7c3010df22afe40a24117f157","crc32":"bf208bb8","sha1":"6cf1299dba7f91190ab696d71f14fa8cd0fbdc69"},{"name":"Sciencei1956_3_reviews.xml","source":"metadata","format":"Metadata","mtime":"1338616286","size":"1089","md5":"5a22eb033b2be6f8cebdf51bb57a48c0","crc32":"26ca0af0","sha1":"304b00385e26a3cc75d39304a53cf80ac6473cfd"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1691351262","size":"6881","md5":"874150974e5325a414b5f1f393bfde65","crc32":"66570f26","sha1":"4fe9091ee119d3f3c2dd01341e6827c4aa34afea","format":"Item Tile","rotation":"0"}],"files_count":42,"item_last_updated":1691352156,"item_size":532281595,"metadata":{"identifier":"Sciencei1956_3","title":"Science in Action: Drilling for Oil (Part I)","creator":"California Academy of Sciences","mediatype":"movies","collection":["prelinger","moviesandfilms"],"description":"Kinescope of Fifties science TV program featuring discussions and demonstrations.    In this episode, host Earl Herald interviews Howard G. Vesper, VP of Standard Oil Company of California, about the science of oil drilling.","date":"1956","year":"1956","subject":"Science;  Television programs;Oil Industry;Occupations: Oil Workers","publicdate":"2007-07-17 00:34:49","addeddate":"2007-07-17 00:34:18","uploader":"aravis77@hotmail.com","updater":["aravis77","aravis77"],"updatedate":["2007-07-17 00:38:10","2007-07-17 00:59:05"],"sound":"sound","color":"color","backup_location":"ia903601_4","closed_captioning":"no","whisper_asr_module_version":"20230805.01","ccnum":"asr"},"reviews":[{"reviewbody":"Excellent demonstration of oil exploration and drilling which (I found out years ago) was common knowledge to every elementary schooler in Texas - apparently known by many a Californian kid too, at least in the golden state's  heyday before pot cultivation stole the show. \n\nHaving grown up in a state with little petroleum production this very well done demo proves that you can teach an old dog new tricks - at the age of 60 I finally got a handle on how oil collects, how it is found and the methods employed in obtaining it.\n\nUndoubtedly one of the best films in this collection.   I can't believe it's 2012 and this is the first review. ","reviewtitle":"So That's How They Find/Get Oil","reviewer":"JayKay49","reviewdate":"2012-06-02 05:51:06","createdate":"2012-06-02 05:51:06","stars":"5"}],"server":"dn600304.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn600304":{"sys_changed_by":{"source":"task","task_id":"5413773169"},"sys_last_changed":"2026-06-03 10:40:06.678642"}}},"solo":true,"uniq":1607180021,"workable_servers":["dn600304.us.archive.org"]}